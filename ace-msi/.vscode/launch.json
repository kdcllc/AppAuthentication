    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "IDENTITY_ENDPOINT": "http://localhost:5050/oauth2/token",
                "IDENTITY_HEADER": "199aef00-4bd2-441f-9139-9574d001fc89"
            },
        }
    ]
}